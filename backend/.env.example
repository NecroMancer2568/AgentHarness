# Ollama Cloud API key: create one at https://ollama.com/settings/keys
OLLAMA_API_KEY=replace_me
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=deepseek-v4-pro:cloud
OLLAMA_TIMEOUT_SECONDS=180

# Keep repositories inside this directory. Clone/commit a repo here before running tasks.
AGENTHARNESS_REPOS_ROOT=workspace/repositories
AGENTHARNESS_RUNS_ROOT=workspace/runs
AGENTHARNESS_DATABASE=workspace/agentharness.sqlite3
AGENTHARNESS_MAX_AGENT_STEPS=8
AGENTHARNESS_MAX_PARALLEL_READERS=2
AGENTHARNESS_TEST_TIMEOUT_SECONDS=180
AGENTHARNESS_BENCHMARK_SAMPLE_TIMEOUT_SECONDS=1800
AGENTHARNESS_MAX_TOOL_OUTPUT_CHARS=12000
AGENTHARNESS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
