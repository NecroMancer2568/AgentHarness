# LLM Provider configuration (OpenRouter API)
# Create an API key at https://openrouter.ai/settings/keys
LLM_PROVIDER=openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_TIMEOUT_SECONDS=180
OPENROUTER_MAX_RETRIES=2

# Optional metadata headers for OpenRouter rankings/analytics
OPENROUTER_HTTP_REFERER=
OPENROUTER_TITLE=AgentHarness Lab

# Workspace & Storage configuration
AGENTHARNESS_REPOS_ROOT=workspace/repositories
AGENTHARNESS_RUNS_ROOT=workspace/runs
AGENTHARNESS_DATABASE=workspace/agentharness.sqlite3
AGENTHARNESS_VENV_CACHE_ROOT=workspace/venvs

# Execution limits & timeouts
AGENTHARNESS_MAX_AGENT_STEPS=8
AGENTHARNESS_MAX_PARALLEL_READERS=2
AGENTHARNESS_TEST_TIMEOUT_SECONDS=180
AGENTHARNESS_BENCHMARK_SAMPLE_TIMEOUT_SECONDS=1800
AGENTHARNESS_MAX_TOOL_OUTPUT_CHARS=12000
AGENTHARNESS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
