# ==============================================================================
# AgentHarness Lab — Environment Configuration
# ==============================================================================

# LLM / Ollama Configuration
# Inside Docker Compose network, use the internal service hostname:
OLLAMA_BASE_URL=http://ollama:11434/v1
# When running backend locally without Docker, use:
# OLLAMA_BASE_URL=http://localhost:11434/v1
# When using Ollama Cloud directly:
# OLLAMA_BASE_URL=https://ollama.com/v1

# Configured Model:
# Default cloud-proxy model (requires OLLAMA_API_KEY when using Ollama Cloud proxy):
OLLAMA_MODEL=gemma4:31b-cloud
# Compatible self-hosted local models (no cloud key required, weights downloaded to volume):
# OLLAMA_MODEL=qwen2.5-coder:7b
# OLLAMA_MODEL=gemma2:9b
# OLLAMA_MODEL=llama3.2:3b

# Ollama API Key:
# Optional for self-hosted local models without authentication.
# Required for Ollama Cloud proxy models (gemma4:31b-cloud, deepseek-v4-pro:cloud).
OLLAMA_API_KEY=

OLLAMA_TIMEOUT_SECONDS=180

# Workspace storage (persists runs, test databases, cloned repositories)
WORKSPACE_PATH=./workspace

# Ports (for Docker Compose host port mappings)
FRONTEND_PORT=5173
BACKEND_PORT=8000
OLLAMA_PORT=11434

# Agent Execution Limits
AGENTHARNESS_MAX_AGENT_STEPS=8
AGENTHARNESS_MAX_PARALLEL_READERS=2
AGENTHARNESS_TEST_TIMEOUT_SECONDS=180
AGENTHARNESS_DEPENDENCY_TIMEOUT_SECONDS=300

# CORS Origins (comma-separated)
AGENTHARNESS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,http://localhost

# Frontend API URL (optional build-time override; leave blank so Nginx reverse-proxies /api/)
# VITE_API_BASE_URL=

